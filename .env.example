# SimEval environment configuration (copy to .env to override defaults).

# Backend
SIMEVAL_DATABASE_URL=sqlite:///./simeval.db
SIMEVAL_ARTIFACT_ROOT=artifacts
SIMEVAL_MAX_CONCURRENT_EXPERIMENTS=1
SIMEVAL_EPISODE_TIMEOUT_S=120
SIMEVAL_DEBUG=false

# Frontend (Vite). Leave unset in development to use the Vite /api proxy.
# VITE_API_BASE=http://127.0.0.1:8000/api/v1
